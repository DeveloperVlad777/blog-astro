---
import { boldToHtml } from "../../lib/markdown";

interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
}

const { title, description, buttonText, buttonUrl } = Astro.props;
---

<div class="promo">
  <p class="promo-title">{title}</p>
  <p class="promo-description" set:html={boldToHtml(description)} />
  <a class="promo-button" href={buttonUrl}>{buttonText}</a>
</div>

<style>
  .promo {
    background: linear-gradient(135deg, #1b1b1f 0%, #23242a 100%);
    border: 1px solid var(--color-accent-dim);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.4),
      inset 0 0 0 1px rgba(255, 221, 45, 0.08);
    border-radius: var(--radius-lg);
    padding: 28px 28px 24px;
    margin-top: 48px;
  }

  .promo-title {
    color: var(--color-heading);
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 12px;
    max-width: 980px;
  }

  .promo-description {
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 980px;
  }

  .promo-description :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .promo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 16px;
    font-weight: 700;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.1px;
    transition:
      transform 0.15s var(--ease),
      background 0.15s var(--ease);
  }

  .promo-button:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 767px) {
    .promo {
      padding: 24px 20px 20px;
    }

    .promo-title {
      font-size: 18px;
    }

    .promo-button {
      width: 100%;
    }
  }
</style>
