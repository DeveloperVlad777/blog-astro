---
import { formatDate, formatReadingTime, type Locale } from "../../lib/i18n";

interface Props {
  hook: string;
  title: string;
  readingMinutes: number;
  publishDate: Date;
  lang: Locale;
}

const { hook, title, readingMinutes, publishDate, lang } = Astro.props;
---

<div class="hook">{hook}</div>
<h1 class="title">{title}</h1>
<div class="meta">
  <span>{formatReadingTime(readingMinutes, lang)}</span>
  <span class="sep">|</span>
  <span>{formatDate(publishDate, lang)}</span>
</div>

<style>
  .hook {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .title {
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0 0 28px;
    max-width: 980px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--color-text);
    font-size: 14px;
    letter-spacing: 0.2px;
    opacity: 0.8;
    margin-bottom: 40px;
  }

  .sep {
    color: var(--color-faint);
    font-weight: 300;
  }

  @media (max-width: 767px) {
    .title {
      font-size: 30px;
      letter-spacing: -0.3px;
    }
  }

  @media (max-width: 380px) {
    .hook {
      font-size: 11px;
      letter-spacing: 1.3px;
      margin-bottom: 14px;
    }

    .title {
      font-size: 26px;
      line-height: 1.12;
      margin-bottom: 22px;
    }

    .meta {
      font-size: 13px;
      margin-bottom: 26px;
    }
  }
</style>
