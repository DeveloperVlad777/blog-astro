---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<Image class="hero" src={image} alt={alt} widths={[480, 800, 1160]} sizes="(max-width: 767px) 100vw, 1160px" />

<style>
  .hero {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin-bottom: 28px;
  }
</style>
