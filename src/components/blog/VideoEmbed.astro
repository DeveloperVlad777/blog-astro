---
interface Props {
  youtubeId: string;
  alt: string;
  caption?: string;
  label?: string;
}

const { youtubeId, alt, caption, label } = Astro.props;
const thumbnail = `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`;
const watchUrl = `https://youtu.be/${youtubeId}`;
---

{
  caption && label && (
    <p class="caption">
      {caption} <a class="watch-link" href={watchUrl}>{label}</a>
    </p>
  )
}
<button class="video" type="button" data-youtube-id={youtubeId} aria-label={alt}>
  <img src={thumbnail} alt={alt} loading="lazy" />
  <span class="play" aria-hidden="true">
    <svg width="32" height="36" viewBox="0 0 32 36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M32 18L2 35.3205L2 0.679491L32 18Z" fill="#101012"></path>
    </svg>
  </span>
</button>

<style>
  .caption {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 18px;
  }

  .watch-link {
    color: var(--color-accent);
    font-weight: 600;
  }

  .watch-link:hover {
    opacity: 0.85;
  }

  .video {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 20px 0 32px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play::before {
    content: "";
    position: absolute;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-accent);
    transition: transform 0.15s var(--ease);
  }

  .play svg {
    position: relative;
    margin-left: 4px;
  }

  .video:hover .play::before {
    transform: scale(1.06);
  }

  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".video").forEach((el) => {
    el.addEventListener(
      "click",
      () => {
        const id = el.dataset.youtubeId;
        el.innerHTML = "";
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        el.appendChild(iframe);
      },
      { once: true },
    );
  });
</script>
