---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CategoryKey } from "../../lib/i18n";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  category: CategoryKey;
  dateLabel: string;
  title: string;
  description: string;
}

const { href, image, imageAlt, category, dateLabel, title, description } = Astro.props;
---

<a class="card" href={href} data-category={category}>
  <div class="card-image">
    <Image src={image} alt={imageAlt} width={400} height={234} />
  </div>
  <div class="card-body">
    <time class="card-date">{dateLabel}</time>
    <h3 class="card-title">{title}</h3>
    <p class="card-excerpt">{description}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: inherit;
  }

  .card-image {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 400 / 234;
  }

  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }

  .card:hover .card-image :global(img) {
    transform: scale(1.04);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-date {
    font-size: 13px;
    color: var(--color-muted);
  }

  .card-title {
    color: var(--color-heading);
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
  }

  .card-excerpt {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
