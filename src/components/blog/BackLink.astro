---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back-link" href={href}>
  <span class="arrow" aria-hidden="true">←</span>
  <span>{label}</span>
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 36px;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.85;
  }

  .arrow {
    font-size: 20px;
    line-height: 1;
  }

  @media (max-width: 767px) {
    .back-link {
      font-size: 16px;
      margin-bottom: 28px;
    }
  }
</style>
