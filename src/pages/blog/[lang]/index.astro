---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/blog/ArticleCard.astro";
import CategoryFilter from "../../../components/blog/CategoryFilter.astro";
import { getArticlesForLocale } from "../../../lib/blog";
import { LOCALES, dictionary, formatDate, articlePath, type Locale, type CategoryKey } from "../../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = dictionary[lang];
const articles = await getArticlesForLocale(lang);
const categories = Object.keys(t.categories) as CategoryKey[];
---

<BaseLayout title={`${t.blogTitle} | Hash Hedge`} description={t.blogSubtitle}>
  <section class="container section">
    <div class="intro">
      <h1>{t.blogTitle}</h1>
      <p>{t.blogSubtitle}</p>
    </div>

    <CategoryFilter lang={lang} categories={categories} gridId="article-grid" />

    <div class="grid" id="article-grid">
      {
        articles.map((article) => (
          <ArticleCard
            href={articlePath(article.data.articleId, article.data.lang)}
            image={article.data.heroImage}
            imageAlt={article.data.heroImageAlt}
            category={article.data.category}
            dateLabel={formatDate(article.data.publishDate, article.data.lang)}
            title={article.data.title}
            description={article.data.description}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 60px 100px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 640px;
    margin: 0 auto;
  }

  .intro h1 {
    font-size: 48px;
  }

  .intro p {
    font-size: 18px;
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .intro h1 {
      font-size: 32px;
    }
  }
</style>
